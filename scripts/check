#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

case "${1:-}" in
  "") mode=full ;;
  --quick) mode=quick ;;
  *) echo 'Usage: scripts/check [--quick]' >&2; exit 2 ;;
esac
if (( $# > 1 )); then
  echo 'Usage: scripts/check [--quick]' >&2
  exit 2
fi

# Directly installed binaries can bypass rustup's toolchain-file selection.
expected=$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)
actual=$(rustc --version)
if [[ "$actual" != "rustc $expected "* ]]; then
  echo "Expected Rust $expected; found $actual. Install/select rust-toolchain.toml." >&2
  exit 1
fi

for script in scripts/check .githooks/pre-commit; do
  bash -n "$script"
done
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s scripts/tests -v
cargo fmt --all -- --check
if [[ "$mode" == quick ]]; then
  cargo check --workspace --all-targets --locked
else
  cargo clippy --workspace --all-targets --locked -- -D warnings
  cargo test --workspace --locked
fi
